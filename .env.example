# "mock" runs fully offline with a deterministic extractor (great for demos and tests).
# "openai" uses the OpenAI API with structured output + function calling.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Thresholds
OCR_CONF_THRESHOLD=70        # word-level OCR confidence (0-100) below this is flagged
MATCH_THRESHOLD=85           # donor match score (0-100) below this needs confirmation
AI_CONF_THRESHOLD=0.8        # model's self-reported confidence (0-1) below this is flagged

GIFTFLOW_DB=giftflow.db
