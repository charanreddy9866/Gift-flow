# Copy to .env and fill in. Works with both `streamlit run app.py` and
# `docker run --env-file .env giftflow`. Keep comments on their own lines:
# Docker's --env-file does not strip comments after a value.

# "mock" runs fully offline with a deterministic extractor (great for demos and tests).
# "openai" uses the OpenAI API with structured output + function calling.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Thresholds
# Word-level OCR confidence (0-100) below this is flagged
OCR_CONF_THRESHOLD=70
# Donor match score (0-100) below this needs confirmation
MATCH_THRESHOLD=85
# Model's self-reported confidence (0-1) below this is flagged
AI_CONF_THRESHOLD=0.8

# Database file for local runs. Leave unset in Docker (the image uses /data/giftflow.db).
# GIFTFLOW_DB=giftflow.db
